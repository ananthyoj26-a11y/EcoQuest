# ==========================================
# ECOQUEST ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your values.
# ==========================================

# ==========================================
# GEMINI AI (Required for AI Vision verification & AI Coach)
# ==========================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ==========================================
# APP URL (Your deployed Vercel URL)
# ==========================================
VITE_APP_URL="https://ecoquest-campus.vercel.app"
APP_URL="https://ecoquest-campus.vercel.app"

# ==========================================
# FIREBASE WEB SDK CONFIGURATION
# Get these from Firebase Console → Project Settings → Your Apps → Web App
# Also add your Vercel domain + localhost to Firebase Auth → Authorized Domains
# ==========================================
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# ==========================================
# SUPABASE (Optional - used as secondary/analytics DB)
# Get these from Supabase Dashboard → Project Settings → API
# ==========================================
VITE_SUPABASE_URL="https://your_project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 1. Firebase Auth: Add these domains to Firebase Console → Auth → Authorized Domains:
#    - localhost
#    - your-vercel-app.vercel.app
#    - your-custom-domain.com (if applicable)
#
# 2. Firestore: Deploy firestore.rules with: firebase deploy --only firestore:rules
#
# 3. Vercel: Add all VITE_* and server-side env vars in Vercel Dashboard → Settings → Environment Variables
