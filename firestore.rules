rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Root User Identity
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate Detailed User Profile
    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Progress Data
    match /userProgress/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Impact Data
    match /userImpact/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Preferences
    match /userPreferences/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Avatars & Cosmetics
    match /userAvatars/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Achievements & Badges
    match /userAchievements/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Separate User Notifications
    match /userNotifications/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Game Collections
    match /quests/{questId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bounties/{bountyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /guilds/{guildId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    match /shopItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /liveActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
